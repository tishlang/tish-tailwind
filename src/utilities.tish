    { cls: "z-0", css: `.z-0 { z-index: 0; }` },
    { cls: "z-[120]", css: `.z-\\[120\\] { z-index: 120; }` },
    { cls: "z-[20000]", css: `.z-\\[20000\\] { z-index: 20000; }` },
    { cls: "z-[6]", css: `.z-\\[6\\] { z-index: 6; }` },
  ]
}